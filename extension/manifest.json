{
  "manifest_version": 3,
  "name": "Busted",
  "short_name": "Busted",
  "version": "0.3.0",
  "description": "Smoke alarm, not weather forecast. See the original supplier price on any dropship product page.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://buy-pass-silk.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Busted — Dropship markup detector",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "*://*.aliexpress.com/*",
        "*://*.busted.app/*",
        "*://*.google.com/*",
        "*://*.youtube.com/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon-48.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
