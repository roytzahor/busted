generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Cached product analysis — 14-day TTL enforced at query time.
model ScannedProduct {
  id             String   @id @default(cuid())
  originalUrl    String   @unique
  scrapeData     Json?
  aiPrediction   Json?
  aliexpressUrl  String?
  aliexpressData Json?
  /// Per-service event timeline emitted during the scan.
  events         Json?
  lastScrapedAt  DateTime
  createdAt      DateTime @default(now())

  searchHistory SearchHistory[]

  @@index([originalUrl])
  @@index([lastScrapedAt])
}

/// Per-service stage cache — lets us re-run individual pipeline stages
/// (identifier, verdict, search, match) without re-scraping. Keyed by
/// sha256(stage + promptVersion + inputHash).
model StageCache {
  key       String   @id
  stage     String
  payload   Json
  createdAt DateTime @default(now())
  ttl       Int      @default(1209600)

  @@index([stage, createdAt])
}

/// Authenticated user for LTV tracking and search history.
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  totalSavingsUsd Decimal  @default(0) @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  searchHistory SearchHistory[]

  @@index([email])
}

/// Raw HTML/markdown cache for fetchProductPage() — dual-arm scraper output.
///
/// Keyed by sha256(url). Both html and markdown are stored gzip-compressed
/// (typical Shopify page: 300 KB raw → 28 KB compressed). The source field
/// records which arm produced the content so callers see the original scraper
/// name even on cache hits.
///
/// 14-day TTL enforced at query time (see lib/scraper/page-cache.ts).
model FetchedPage {
  /// sha256(url) — fixed 64-char hex string, used directly as PK.
  cacheKey  String   @id
  url       String   @unique
  /// Gzip-compressed HTML bytes. Null when the arm returned no HTML.
  html      Bytes?
  /// Gzip-compressed markdown bytes. Null when the arm returned no markdown.
  markdown  Bytes?
  /// "crawlbase" | "firecrawl" — the arm that produced this payload.
  source    String
  /// Compressed size in bytes. Useful for monitoring storage costs.
  sizeBytes Int
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  lastHitAt DateTime @default(now())

  @@index([url])
  @@index([createdAt])
}

/// Cached output of Gemini Vision image preprocessing (crop, background
/// normalisation, brand-text inpaint). Keyed by sha256(sourceImageUrl + "|" +
/// productCategory) so cache invalidates if either input changes.
///
/// Cleaned image is stored as raw bytes — typical JPEG ≈ 50–100 KB.
/// 30-day TTL enforced at query time (see lib/ai/preprocess-cache.ts).
model PreprocessedImage {
  id              String   @id @default(cuid())
  /// sha256 hex digest used as the lookup key (NOT the source URL — keeps
  /// keys uniform length and free of unicode oddities from Shopify CDNs).
  cacheKey        String   @unique
  sourceImageUrl  String
  productCategory String
  processedImage  Bytes
  format          String   @default("jpg")
  width           Int
  height          Int
  /// Bytes-on-disk for the processed payload. Useful for cost monitoring.
  payloadBytes    Int
  hits            Int      @default(0)
  createdAt       DateTime @default(now())
  lastHitAt       DateTime @default(now())
  /// Vision-analysis payload extracted in the same Gemini round-trip as the
  /// image cleanup. Stored as JSON string arrays. Null on rows created before
  /// these fields were added — callers must treat null as an empty array.
  ocrTraces       Json?
  materialTokens  Json?
  technicalSpecs  Json?

  @@index([cacheKey])
  @@index([createdAt])
  @@index([productCategory])
}

/// Tracks affiliate-link validation outcomes per (product, country) pair.
/// Used to down-rank candidates whose links reliably fail for a given
/// country so buyers in that market don't see broken purchase flows.
///
/// A failure rate > 80% over ≥5 outcomes triggers a 0.7× score multiplier
/// in the supplier-matching confidence calculation.
model SupplierReputation {
  id            String    @id @default(cuid())
  productId     String
  shipToCountry String
  linkFailures  Int       @default(0)
  linkSuccesses Int       @default(0)
  lastFailedAt  DateTime?
  lastCheckedAt DateTime  @default(now())

  @@unique([productId, shipToCountry])
  @@index([productId])
  @@index([shipToCountry, lastCheckedAt])
}

/// Per-user search log linked to cached product records.
model SearchHistory {
  id               String   @id @default(cuid())
  userId           String
  scannedProductId String
  savingsUsd       Decimal? @db.Decimal(10, 2)
  searchedAt       DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scannedProduct ScannedProduct @relation(fields: [scannedProductId], references: [id], onDelete: Cascade)

  @@index([userId, searchedAt])
  @@index([scannedProductId])
}

/// First-party analytics — Sprint 11 Stage 26.
///
/// Captures product events with a session-scoped anonymous ID. No PII, no IP,
/// no email. Lets us answer: bounce rate, scan completion, share/affiliate
/// CTR, example-chip effectiveness — without depending on Google Analytics.
model TelemetryEvent {
  id        String   @id @default(cuid())
  /// Event name (e.g. "page_view", "scan_complete"). Lowercase snake_case.
  name      String
  /// Free-form event properties. Keys must not contain PII. Stack with care.
  props     Json?
  /// Anonymous per-session UUID (sessionStorage); rotates on close.
  sessionId String
  /// Optional persisted ScannedProduct.id when the event refers to a scan.
  scanId    String?
  /// Source surface ("web" today; "extension" / "ios" later).
  surface   String   @default("web")
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([sessionId, createdAt])
  @@index([scanId])
}

/// Affiliate-click outbound event — Sprint 11 Stage 27.
///
/// One row per "user clicked the Buy on AliExpress CTA". When the Admitad
/// webhook lands in a future sprint we'll join this to actual revenue.
model AffiliateClick {
  id         String   @id @default(cuid())
  scanId     String?
  /// Tracking surface ("web", "extension").
  surface    String   @default("web")
  /// Anonymous session UUID — same one TelemetryEvent uses.
  sessionId  String?
  /// Destination domain at click time (sanity-check that we sent to AE).
  targetHost String?
  createdAt  DateTime @default(now())

  @@index([scanId])
  @@index([createdAt])
}

/// Client-side error capture — Sprint 11 Stage 29.
///
/// Holds at most one row per (sessionId, errorHash, hour) so a runaway
/// exception loop can't flood the table.
model ClientError {
  id        String   @id @default(cuid())
  message   String   @db.Text
  /// SHA-256 of (message + first stack line) — used for de-dupe.
  errorHash String
  /// Truncated stack trace (4 KB cap).
  stack     String?  @db.Text
  url       String
  userAgent String?  @db.Text
  sessionId String?
  createdAt DateTime @default(now())

  @@index([errorHash, createdAt])
  @@index([createdAt])
}
