# Neon PostgreSQL connection string (pooled, recommended for serverless)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Scraping pipeline
FIRECRAWL_API_KEY=""
SCRAPER_TIMEOUT_MS="30000"
PLAYWRIGHT_FALLBACK_ENABLED="false"

# AI Core Engine — Google Gemini Flash (best cost/latency for parsing & matching)
AI_PROVIDER="google"
# Single key (legacy, still supported):
GOOGLE_AI_API_KEY=""
# Or comma-separated list — Stage 32 failover rotates keys on 429/503 (6h
# per-key cooldown). Either env works; GOOGLE_AI_API_KEYS wins when both set.
GOOGLE_AI_API_KEYS=""
# Primary: gemini-3.5-flash. Fallbacks: gemini-3.1-flash-lite, gemini-2.5-flash-lite
GOOGLE_AI_MODEL="gemini-3.5-flash"

# Image generation model for SmartMatch preprocess (Gemini image-gen tier).
# Default: gemini-2.5-flash-image (available on v1beta; the old gemini-3-flash-image
# returns 404). Only used when PREPROCESS_ENABLED=true.
GOOGLE_AI_IMAGE_MODEL="gemini-2.5-flash-image"

# Conditional SmartMatch preprocess gate (Sprint 12 cost control).
# false (default) → cold scan costs ~$0.0015. SmartMatch still runs with the
# raw source image URL ("url arm") — no image generation, no extra cost.
# true → when initial text+raw-image match score < 0.6, the pipeline pays
# ~$0.039 to preprocess the source image with Gemini (cleaned base64 sent to
# SmartMatch "base64 arm" for higher precision). Only enable once daily scan
# volume is large enough to justify the lift.
PREPROCESS_ENABLED="false"

# Vector index — pgvector-backed ANN candidate arm (ROADMAP Phase 2 item 1).
# false (default) — find-supplier's vector-ann candidate arm is skipped
# entirely; behavior is identical to before this arm existed.
# true — embeds the query text (Gemini gemini-embedding-001) and looks up
# nearest AliExpress-network rows in ProductEmbedding by cosine distance,
# merging results into the same candidate pool every other arm feeds
# (still gated by MATCH_CONFIDENCE_MIN downstream — this only adds
# candidates, never picks a winner itself). Requires `npm run index:ingest`
# to have populated ProductEmbedding first, and should only be turned on
# after the retrieval eval (scripts/eval/retrieval-eval.ts) is green.
VECTOR_INDEX_ENABLED="false"

# Optional fallbacks
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# AliExpress Affiliate API (primary supplier search + link generation)
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""
ALIEXPRESS_TRACKING_ID="busted"
ALIEXPRESS_API_URL="https://api-sg.aliexpress.com/sync"
ALIEXPRESS_SHIP_TO_COUNTRY="US"
ALIEXPRESS_DELIVERY_DAYS="10"
# OAuth callback — auto-derived from VERCEL_URL if unset
# Production example: https://buypass.vercel.app/api/aliexpress/callback
ALIEXPRESS_CALLBACK_URL=""
NEXT_PUBLIC_APP_URL=""

# eBay Buy Browse API (optional — activates eBay as a second supplier source)
# Sandbox: set EBAY_SANDBOX=true and use sandbox App/Cert IDs from developer.ebay.com
# Production: set EBAY_SANDBOX=false (or omit) and use production keys
EBAY_APP_ID=""
EBAY_DEV_ID=""
EBAY_CERT_ID=""
EBAY_SANDBOX="false"
# Optional: affiliate campaign ID — when set, responses include itemAffiliateWebUrl
EBAY_CAMPAIGN_ID=""
# Optional: defaults to EBAY_US
EBAY_MARKETPLACE_ID="EBAY_US"

# Admitad affiliate fallback (optional — used when AFFILIATE_PROVIDER=admitad or auto)
ADMITAD_CLIENT_ID=""
ADMITAD_CLIENT_SECRET=""
ADMITAD_WEBSITE_ID=""
ADMITAD_ALIEXPRESS_CAMPAIGN_ID=""
AFFILIATE_PROVIDER="auto"
