# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated tool artifacts
/graphify-out/
/logs/
*.xlsx

# Nested agent git worktrees (registered via git worktree — never commit into parent)
.claude/worktrees/

# Feedback-harvested fixture drafts — hand-verified before promotion to products/
tests/fixtures/candidates/

# Globally-installed agent skills. `npx skills add -g` installs to ~/.agents/skills
# but ALSO mirrors the tree into the repo (plus a top-level agent/), so a routine
# `git add -A` would commit another machine's skill library. The project's own
# skills are re-included below; everything else under these paths is machine state.
/agent/
/.agents/skills/*
!/.agents/skills/neon-postgres/
/.claude/skills/*
!/.claude/skills/graphify/


# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
